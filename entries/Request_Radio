<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>Request_Radio เพลงเพราะ</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        html, body {
            width: 100%;
            height: 100%;
            background: transparent;
            color: #fff;
            overflow: hidden;
        }

        /* 🌌 วิดีโอพื้นหลังเต็มหน้าจอ ปิดเสียงสนิท */
        .bg-video {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            object-fit: cover;
            z-index: -1;
            pointer-events: none;
        }

        /* 📌 กล่องเพลง (ตัวเล่นวิทยุ) ด้านบนขวา */
        .player-container {
            position: fixed;
            top: 15px;
            right: 10px;
            width: 245px;
            background: rgba(2, 6, 23, 0.35);
            border: 1.5px solid rgba(56, 189, 248, 0.75);
            border-radius: 12px;
            padding: 10px 12px;
            z-index: 2147483647;
            pointer-events: auto;
            touch-action: manipulation;
            text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
        }

        .player-header {
            font-size: 12px;
            font-weight: bold;
            color: #38bdf8;
            margin-bottom: 5px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 4px;
        }

        .live-badge {
            background: rgba(239, 68, 68, 0.92);
            color: #fff;
            font-size: 9px;
            padding: 2px 6px;
            border-radius: 8px;
            font-weight: bold;
            flex-shrink: 0;
        }

        .track-title {
            font-size: 11px;
            font-weight: bold;
            color: #ffffff;
            margin-bottom: 10px;
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
        }

        /* แผงปุ่มควบคุม */
        .control-panel {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 4px;
            margin-bottom: 10px;
        }

        .btn-ctrl {
            width: 36px;
            height: 36px;
            border-radius: 50%;
            border: 1.5px solid rgba(255,255,255,0.4);
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.7);
            transition: transform 0.15s;
            pointer-events: auto;
            touch-action: manipulation;
        }

        .btn-nav { background: #0284c7; color: #fff; }
        .btn-play { background: #10b981; color: #fff; }
        .btn-pause { background: #f59e0b; color: #fff; }
        .btn-stop { background: #ef4444; color: #fff; }
        .btn-ctrl:hover { transform: scale(1.08); }
        .btn-ctrl:active { transform: scale(0.94); }
        .btn-ctrl svg {
            width: 15px;
            height: 15px;
            fill: currentColor;
            pointer-events: none;
        }

        /* ✨ ตัววิ่งชื่อเพลง */
        .marquee-box {
            width: 100%;
            overflow: hidden;
            background: rgba(15, 23, 42, 0.65);
            border: 1px solid rgba(56, 189, 248, 0.6);
            padding: 5px 8px;
            border-radius: 20px;
            position: relative;
        }

        .marquee-text {
            display: block;
            white-space: nowrap;
            font-size: 11px;
            font-weight: bold;
            color: #fde047;
            padding-left: 100%;
            animation: marqueeSlide 18s linear infinite;
            animation-play-state: paused;
        }

        .marquee-box.running .marquee-text {
            animation-play-state: running;
        }

        @keyframes marqueeSlide {
            0% { transform: translateX(0%); }
            100% { transform: translateX(-100%); }
        }

        /* 📌 กรอบรายชื่อเพลง ใต้กล่องเพลง */
        .playlist-container {
            position: fixed;
            top: 175px;
            right: 10px;
            width: 245px;
            background: rgba(2, 6, 23, 0.35);
            border: 1.5px solid rgba(56, 189, 248, 0.85);
            border-radius: 12px;
            padding: 10px 12px;
            max-height: calc(100vh - 188px);
            display: flex;
            flex-direction: column;
            z-index: 2147483647;
            pointer-events: auto;
            touch-action: manipulation;
            overflow: hidden;
            text-shadow: 0 1px 3px #000, 0 0 8px #000;
        }

        .playlist-content {
            position: relative;
            z-index: 2;
            pointer-events: auto;
            display: flex;
            flex-direction: column;
            height: 100%;
            min-height: 0;
        }

        .playlist-title {
            font-size: 12px;
            font-weight: 800;
            margin-bottom: 6px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.35);
            padding-bottom: 5px;
            color: #7dd3fc;
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-shrink: 0;
        }

        .song-list {
            position: relative;
            z-index: 3;
            flex: 1;
            min-height: 110px;
            max-height: 260px;
            overflow-y: auto;
            display: flex;
            flex-direction: column;
            gap: 4px;
            padding-right: 2px;
            pointer-events: auto;
            touch-action: manipulation;
        }

        .song-list::-webkit-scrollbar {
            width: 4px;
        }

        .song-list::-webkit-scrollbar-thumb {
            background: rgba(56, 189, 248, 0.65);
            border-radius: 4px;
        }

        .song-row {
            position: relative;
            z-index: 4;
            padding: 5px 8px;
            background: rgba(2, 6, 23, 0.55);
            border: 1px solid rgba(255, 255, 255, 0.25);
            border-left: 3px solid transparent;
            border-radius: 5px;
            cursor: pointer;
            transition: 0.15s;
            font-size: 11px;
            pointer-events: auto;
            touch-action: manipulation;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 6px;
            flex-shrink: 0;
        }

        .song-row:hover {
            background: rgba(14, 165, 233, 0.42);
            border-color: rgba(125, 211, 252, 0.6);
        }

        .song-row.active {
            background: rgba(14, 165, 233, 0.55);
            border-color: #38bdf8;
            border-left: 3px solid #fde047;
            color: #fef08a;
            font-weight: 800;
        }

        .song-name {
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            color: #ffffff;
            pointer-events: none;
        }

        .song-row.active .song-name {
            color: #fef08a;
        }

        .song-tag {
            font-size: 9px;
            font-weight: bold;
            color: #7dd3fc;
            flex-shrink: 0;
            pointer-events: none;
        }

        .right-footer-widget {
            margin-top: 7px;
            padding-top: 7px;
            border-top: 1px solid rgba(255, 255, 255, 0.3);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 8px;
            flex-shrink: 0;
        }

        .eq-box {
            display: flex;
            align-items: flex-end;
            gap: 3px;
            height: 16px;
        }

        .eq-bar {
            width: 3px;
            height: 100%;
            background: linear-gradient(to top, #0072ff, #38bdf8);
            border-radius: 2px;
            transform-origin: bottom;
            transform: scaleY(0.25);
        }

        .eq-box.playing .eq-bar:nth-child(1) { animation: eqMove 0.55s infinite alternate ease-in-out; }
        .eq-box.playing .eq-bar:nth-child(2) { animation: eqMove 0.4s infinite alternate ease-in-out 0.1s; }
        .eq-box.playing .eq-bar:nth-child(3) { animation: eqMove 0.65s infinite alternate ease-in-out 0.2s; }
        .eq-box.playing .eq-bar:nth-child(4) { animation: eqMove 0.48s infinite alternate ease-in-out 0.15s; }
        .eq-box.playing .eq-bar:nth-child(5) { animation: eqMove 0.6s infinite alternate ease-in-out 0.05s; }

        @keyframes eqMove {
            0% { transform: scaleY(0.2); }
            100% { transform: scaleY(1); }
        }

        .clock-box {
            text-align: right;
            font-size: 10px;
            line-height: 1.3;
        }

        .clock-time {
            font-family: monospace;
            font-size: 11px;
            font-weight: bold;
            color: #ffffff;
        }

        .clock-date {
            font-size: 9px;
            font-weight: bold;
            color: #7dd3fc;
        }
    </style>
</head>
<body>

    <!-- 🌌 วิดีโอพื้นหลัง Background (ปิดเสียงสนิท และวนลูบต่อเนื่อง) -->
    <video id="bg-video" class="bg-video" src="https://ia600805.us.archive.org/21/items/hailuo014/hailuo014.mp4" autoplay loop muted playsinline preload="auto"></video>

    <!-- 🎧 กล่องเพลง (ตัวเล่นวิทยุ) ด้านบนขวา -->
    <div class="player-container" id="radio-player">
        <div class="player-header">
            <span>🎧 Request_Radio</span>
            <span class="live-badge" id="status-badge">LOOP</span>
        </div>
        <div class="track-title" id="current-title">🎵 สตริงใหม่ล่าสุด</div>

        <div class="control-panel">
            <button type="button" class="btn-ctrl btn-nav" id="btn-prev" title="เพลงก่อนหน้า (Prev)">
                <svg viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
            </button>
            <button type="button" class="btn-ctrl btn-play" id="btn-play" title="เล่น (Play)">
                <svg viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
            </button>
            <button type="button" class="btn-ctrl btn-pause" id="btn-pause" title="พักชั่วคราว (Pause)">
                <svg viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
            </button>
            <button type="button" class="btn-ctrl btn-stop" id="btn-stop" title="หยุดเล่น (Stop)">
                <svg viewBox="0 0 24 24"><path d="M6 6h12v12H6z"/></svg>
            </button>
            <button type="button" class="btn-ctrl btn-nav" id="btn-next" title="เพลงถัดไป (Next)">
                <svg viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
            </button>
        </div>

        <!-- ✨ ตัววิ่งชื่อเพลง -->
        <div class="marquee-box running" id="marquee-box">
            <div class="marquee-text" id="marquee-text">🎶 พร้อมเล่น: สตริงใหม่ล่าสุด • Request_Radio 🎶</div>
        </div>
    </div>

    <!-- 📻 กล่องรายชื่อเพลง ใต้กล่องเพลง -->
    <div class="playlist-container" id="right-playlist">
        <div class="playlist-content">
            <div class="playlist-title">
                <span>รายชื่อเพลง</span>
                <span style="font-size: 10px;" id="song-count-label">8 เพลง</span>
            </div>

            <div class="song-list" id="song-list"></div>

            <!-- 📊 EQ + นาฬิกาและวันที่ -->
            <div class="right-footer-widget">
                <div class="eq-box" id="eq-box">
                    <div class="eq-bar"></div>
                    <div class="eq-bar"></div>
                    <div class="eq-bar"></div>
                    <div class="eq-bar"></div>
                    <div class="eq-bar"></div>
                </div>
                <div class="clock-box">
                    <div class="clock-time" id="clock-time">00:00:00</div>
                    <div class="clock-date" id="clock-date">00/00/0000</div>
                </div>
            </div>
        </div>
    </div>

    <audio id="audio-player" preload="auto"></audio>

    <script>
        const bgVideo = document.getElementById('bg-video');
        function keepVideoSilentLoop() {
            bgVideo.loop = true;
            bgVideo.muted = true;
            bgVideo.volume = 0;
            bgVideo.play().catch(() => {});
        }
        keepVideoSilentLoop();
        bgVideo.addEventListener('volumechange', keepVideoSilentLoop);
        bgVideo.addEventListener('loadeddata', keepVideoSilentLoop);
        document.addEventListener('pointerdown', keepVideoSilentLoop, { once: true });

        const tracks = [
            { title: 'สตริงใหม่ล่าสุด', url: 'https://ia600607.us.archive.org/28/items/sting-new/sting%20new.mp3' },
            { title: 'เพลงฮิต tiktok 2026', url: 'https://files.catbox.moe/f2ngzy.mp3' },
            { title: 'สตริง 1', url: 'https://ia601906.us.archive.org/3/items/radio_202607/1.radio.mp3' },
            { title: 'สตริง 2 ชม', url: 'https://ia601501.us.archive.org/2/items/thaistation-v.-1/thaistation%20v.1.mp3' },
            { title: 'เพลงลูกทุ่ง', url: 'https://ia600903.us.archive.org/29/items/luk-thung-music/Luk%20Thung%20music.mp3' },
            { title: 'เพลงใต้ ชุดใหม่', url: 'https://ia601609.us.archive.org/27/items/plangtai2/plangtai2.mp3' },
            { title: 'เพลงใต้ แนวเพราะ', url: 'https://files.catbox.moe/k4dtxi.mp3' },
            { title: 'ปลาทอง เรดิโอ', url: 'https://radio9.plathong.net/7264/;stream.mp3?type=http' }
        ];

        let currentIndex = 0;
        let isPaused = false;
        const player = document.getElementById('audio-player');
        const titleElement = document.getElementById('current-title');
        const statusBadge = document.getElementById('status-badge');
        const eqBox = document.getElementById('eq-box');
        const songListEl = document.getElementById('song-list');
        const marqueeBox = document.getElementById('marquee-box');
        const marqueeText = document.getElementById('marquee-text');

        document.getElementById('song-count-label').innerText = `${tracks.length} เพลง`;

        function bindAction(el, fn) {
            el.addEventListener('pointerdown', (e) => {
                e.stopPropagation();
                fn();
            });
            el.addEventListener('click', (e) => {
                e.stopPropagation();
            });
        }

        function setPlayingVisuals(playing) {
            if (playing) {
                eqBox.classList.add('playing');
                marqueeBox.classList.add('running');
            } else {
                eqBox.classList.remove('playing');
                marqueeBox.classList.remove('running');
            }
        }

        function syncMarqueeTitle(track, prefix = 'กำลังเล่น') {
            marqueeText.innerText = `🎶 ${prefix}: ${track.title} • Request_Radio 🎶`;
        }

        function highlightSong(index, autoScroll = false) {
            for (let i = 0; i < tracks.length; i++) {
                const row = document.getElementById('song-' + i);
                if (row) row.classList.toggle('active', i === index);
            }
            if (autoScroll) {
                const activeRow = document.getElementById('song-' + index);
                if (activeRow) {
                    activeRow.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
                }
            }
        }

        function renderSongList() {
            songListEl.innerHTML = '';
            tracks.forEach((track, idx) => {
                const row = document.createElement('div');
                row.id = 'song-' + idx;
                row.dataset.index = idx;
                row.className = 'song-row' + (idx === currentIndex ? ' active' : '');

                const nameSpan = document.createElement('span');
                nameSpan.className = 'song-name';
                nameSpan.innerText = `${idx + 1}. ${track.title}`;

                const tagSpan = document.createElement('span');
                tagSpan.className = 'song-tag';
                tagSpan.innerText = 'LOOP';

                row.appendChild(nameSpan);
                row.appendChild(tagSpan);
                songListEl.appendChild(row);
            });
        }

        function handleSongListTrigger(e) {
            const row = e.target.closest('.song-row');
            if (!row || !songListEl.contains(row)) return;
            e.stopPropagation();
            const idx = Number(row.dataset.index);
            if (!Number.isNaN(idx)) {
                startPlaylist(idx);
            }
        }

        songListEl.addEventListener('pointerdown', handleSongListTrigger);
        songListEl.addEventListener('click', (e) => {
            if (e.target.closest('.song-row')) {
                e.stopPropagation();
            }
        });

        function startPlaylist(index = 0) {
            currentIndex = (index + tracks.length) % tracks.length;
            isPaused = false;

            player.pause();
            player.muted = false;
            player.volume = 1;
            player.src = tracks[currentIndex].url;
            player.load();

            titleElement.innerText = `🎵 ${tracks[currentIndex].title}`;
            syncMarqueeTitle(tracks[currentIndex], 'กำลังเล่น');
            statusBadge.innerText = "LOOP";
            statusBadge.style.background = "#10b981";
            highlightSong(currentIndex, true);
            setPlayingVisuals(true);

            const p = player.play();
            if (p !== undefined) {
                p.catch(() => {
                    statusBadge.innerText = "TAP PLAY";
                    setPlayingVisuals(false);
                });
            }
        }

        function handlePrev() {
            startPlaylist(currentIndex - 1);
        }

        function handleNext() {
            startPlaylist(currentIndex + 1);
        }

        function handlePlay() {
            if (isPaused && player.src) {
                isPaused = false;
                player.muted = false;
                player.volume = 1;
                titleElement.innerText = `🎵 ${tracks[currentIndex].title}`;
                syncMarqueeTitle(tracks[currentIndex], 'กำลังเล่น');
                statusBadge.innerText = "LOOP";
                statusBadge.style.background = "#10b981";
                setPlayingVisuals(true);
                player.play().catch(() => {});
            } else {
                startPlaylist(currentIndex);
            }
        }

        function handlePause() {
            player.pause();
            isPaused = true;
            titleElement.innerText = `พัก: ${tracks[currentIndex].title}`;
            syncMarqueeTitle(tracks[currentIndex], 'พักชั่วคราว');
            statusBadge.innerText = "PAUSED";
            statusBadge.style.background = "#f59e0b";
            setPlayingVisuals(false);
        }

        function handleStop() {
            player.pause();
            player.muted = true;
            player.volume = 0;
            player.currentTime = 0;
            player.removeAttribute('src');
            player.src = '';
            player.load();
            isPaused = false;
            currentIndex = 0;
            titleElement.innerText = "หยุดเล่นเพลงแล้ว";
            marqueeText.innerText = "🎶 หยุดเล่นเพลงแล้ว • Request_Radio 🎶";
            statusBadge.innerText = "STOPPED";
            statusBadge.style.background = "#ef4444";
            highlightSong(0, false);
            setPlayingVisuals(false);
        }

        player.addEventListener('ended', () => {
            startPlaylist(currentIndex + 1);
        });

        renderSongList();
        syncMarqueeTitle(tracks[0], 'พร้อมเล่น');
        bindAction(document.getElementById('btn-prev'), handlePrev);
        bindAction(document.getElementById('btn-next'), handleNext);
        bindAction(document.getElementById('btn-play'), handlePlay);
        bindAction(document.getElementById('btn-pause'), handlePause);
        bindAction(document.getElementById('btn-stop'), handleStop);

        function updateClock() {
            const now = new Date();
            const hh = String(now.getHours()).padStart(2, '0');
            const mm = String(now.getMinutes()).padStart(2, '0');
            const ss = String(now.getSeconds()).padStart(2, '0');
            const dd = String(now.getDate()).padStart(2, '0');
            const mo = String(now.getMonth() + 1).padStart(2, '0');
            const yyyy = now.getFullYear();

            document.getElementById('clock-time').innerText = `${hh}:${mm}:${ss}`;
            document.getElementById('clock-date').innerText = `${dd}/${mo}/${yyyy}`;
        }
        setInterval(updateClock, 1000);
        updateClock();
    </script>
</body>
</html>
